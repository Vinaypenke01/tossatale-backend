# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,finroute01.pythonanywhere.com

# Database Toggle (Set USE_POSTGRES=True for PostgreSQL, USE_POSTGRES=False for local SQLite)
USE_POSTGRES=False
DATABASE_URL=postgresql://postgres:123456@localhost:5432/tossatale

# Cache & Celery Development Flags (Set USE_REDIS=True if running Redis server locally)
USE_REDIS=False
CELERY_TASK_ALWAYS_EAGER=True

# Redis Connection (Used when USE_REDIS=True or in Production)
REDIS_URL=redis://localhost:6379/0

# JWT Token Lifetime
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Resend API (Email Provider Credentials)
RESEND_API_KEY=your-resend-api-key
DEFAULT_FROM_EMAIL=hello@tossatale.com

# Frontend URL (for CORS and reset links)
FRONTEND_URL=http://localhost:8080,https://tossatale.com

# Celery Broker and Result Backend
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# CORS & CSRF Trusted Origins
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,https://tossatale.com,https://www.tossatale.com
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:3000,https://tossatale.com,https://www.tossatale.com
